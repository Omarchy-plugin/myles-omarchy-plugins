#!/bin/bash
# omarchy:summary=Update every Mylesoft Omarchy plugin installed on this machine
# omarchy:group=plugin

# Pulls updates for the plugins published by the Omarchy-plugin organisation.
#
# Only plugins whose id starts with the configured prefix are touched, so this
# never silently updates third-party plugins you installed from elsewhere.
#
# `omarchy plugin update` needs --yes: it refuses to run without a confirmation
# prompt when it has no TTY, which is exactly the case under a hook or a timer.
# It fast-forwards only, re-validates the folder, and rolls back if validation
# fails, so a bad push upstream cannot break the running shell.

set -uo pipefail

PLUGIN_PREFIX="${MYLES_PLUGIN_PREFIX:-myles.}"
PLUGINS_DIR="${OMARCHY_PLUGIN_DIR:-$HOME/.config/omarchy/plugins}"
LOG="${MYLES_PLUGIN_UPDATE_LOG:-${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/myles-plugin-update.log}"

log() { printf '%s %s\n' "$(date -Is)" "$*" >>"$LOG" 2>/dev/null || true; }

# One updater at a time. Two concurrent runs would race on the same git
# checkouts and can both fail a fast-forward.
LOCK="${XDG_RUNTIME_DIR:-/tmp}/myles-plugin-update.lock"

# Reclaim the lock if the previous holder died. A stale lock must not block
# updates until the next reboot.
if ! mkdir "$LOCK" 2>/dev/null; then
  if [[ -r $LOCK/pid ]]; then
    oldpid="$(cat "$LOCK/pid" 2>/dev/null || true)"
    if [[ -n $oldpid ]] && kill -0 "$oldpid" 2>/dev/null; then
      log "another update is already running (pid $oldpid); exiting"
      exit 0
    fi
    log "clearing stale lock from pid ${oldpid:-unknown}"
  fi
  rm -rf "$LOCK" 2>/dev/null || true
  if ! mkdir "$LOCK" 2>/dev/null; then
    log "could not acquire the lock; exiting"
    exit 0
  fi
fi
echo $$ >"$LOCK/pid" 2>/dev/null || true

# rmdir only removes an empty directory, so clear the pid file first. Using
# rmdir rather than rm -rf keeps a mistyped path from ever becoming recursive.
trap 'rm -f "$LOCK/pid" 2>/dev/null; rmdir "$LOCK" 2>/dev/null || true' EXIT

mkdir -p "$(dirname "$LOG")"

[[ -d $PLUGINS_DIR ]] || { log "no plugin directory at $PLUGINS_DIR"; exit 0; }

updated=()
failed=()

for dir in "$PLUGINS_DIR"/*/; do
  id="$(basename "$dir")"
  [[ $id == "$PLUGIN_PREFIX"* ]] || continue
  # Only a git checkout can be updated. A plain directory is a local copy.
  [[ -d $dir/.git ]] || { log "skip $id: not a git checkout"; continue; }

  if out="$(omarchy plugin update "$id" --yes 2>&1)"; then
    if grep -q '^Updated ' <<<"$out"; then
      updated+=("$id")
      log "updated $id"
    fi
  else
    failed+=("$id")
    log "FAILED $id: $(tr '\n' ' ' <<<"$out")"
  fi
done

# omarchy plugin update already calls rescanPlugins when it changes anything,
# so the running shell picks the new code up without a restart.

if ((${#updated[@]})); then
  log "updated: ${updated[*]}"
  if command -v omarchy-notification-send >/dev/null 2>&1; then
    omarchy-notification-send "Plugins updated" "${updated[*]}" >/dev/null 2>&1 || true
  fi
else
  log "all up to date"
fi

if ((${#failed[@]})); then
  log "failed: ${failed[*]}"
  if command -v omarchy-notification-send >/dev/null 2>&1; then
    omarchy-notification-send "Plugin update failed" "${failed[*]} -- see $LOG" >/dev/null 2>&1 || true
  fi
  exit 1
fi

exit 0
